# Environment Configuration for Journal Entry Audit Analytics Platform

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=journal_audit_db
DB_USER=audit_user
DB_PASSWORD=audit_secure_password_2026

# Fallback Database (SQLite) if PostgreSQL container is not running
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=data/journal_audit.db

# Pipeline Settings
DATASET_ROWS=500000
RANDOM_SEED=42
LOG_LEVEL=INFO
